{
 "dashboard": {
  "uid": "frame-health",
  "title": "Photo frame health",
  "tags": [
   "frame"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
   "from": "now-6h",
   "to": "now"
  },
  "schemaVersion": 41,
  "panels": [
   {
    "id": 1,
    "type": "table",
    "title": "Freezes seen by the page",
    "description": "A 1 s tick that ran 2 s or more late. crumbs: the last 40 events before it, newest last, in seconds before the report.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 0,
     "w": 24,
     "h": 9
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "table",
      "rawSql": "SELECT time, \"view\", ms, crumbs FROM freeze WHERE source = 'page' AND client = 'frame' AND $__timeFilter(time) ORDER BY time DESC"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {
       "cellOptions": {
        "type": "auto",
        "wrapText": true
       },
       "inspect": true
      }
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "ms"
       },
       "properties": [
        {
         "id": "unit",
         "value": "ms"
        },
        {
         "id": "custom.width",
         "value": 90
        }
       ]
      },
      {
       "matcher": {
        "id": "byName",
        "options": "view"
       },
       "properties": [
        {
         "id": "custom.width",
         "value": 100
        }
       ]
      },
      {
       "matcher": {
        "id": "byName",
        "options": "time"
       },
       "properties": [
        {
         "id": "custom.width",
         "value": 170
        }
       ]
      }
     ]
    },
    "options": {
     "cellHeight": "sm",
     "showHeader": true
    },
    "transformations": []
   },
   {
    "id": 2,
    "type": "timeseries",
    "title": "Main thread blocked (page)",
    "description": "Per 10 s heartbeat: how late the 1 s tick ran, and the longest task.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 9,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, max(gap_ms) AS \"tick delay\", max(longtask_max_ms) AS \"longest task\" FROM page WHERE client = 'frame' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {
       "drawStyle": "bars",
       "fillOpacity": 60
      },
      "unit": "ms"
     },
     "overrides": []
    },
    "options": {},
    "transformations": []
   },
   {
    "id": 3,
    "type": "timeseries",
    "title": "Keyboard and viewport (page)",
    "description": "The viewport shrinks from 800 when the on-screen keyboard is up.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 12,
     "y": 9,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, min(inner_h) AS \"viewport height\", max(CAST(input_focus AS INT)) AS \"input focused\" FROM page WHERE client = 'frame' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {
       "drawStyle": "line",
       "lineInterpolation": "stepAfter"
      }
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "input focused"
       },
       "properties": [
        {
         "id": "custom.axisPlacement",
         "value": "right"
        }
       ]
      }
     ]
    },
    "options": {},
    "transformations": []
   },
   {
    "id": 4,
    "type": "state-timeline",
    "title": "View on screen (page)",
    "description": "",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 17,
     "w": 24,
     "h": 5
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT time, \"view\" FROM page WHERE client = 'frame' AND $__timeFilter(time) ORDER BY time"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {}
     },
     "overrides": []
    },
    "options": {
     "showValue": "auto",
     "mergeValues": true,
     "rowHeight": 0.8
    },
    "transformations": []
   },
   {
    "id": 5,
    "type": "timeseries",
    "title": "JS heap and DOM size (page)",
    "description": "",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 22,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, max(heap_mb) AS \"heap\", max(dom_nodes) AS \"DOM nodes\" FROM page WHERE client = 'frame' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {}
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "DOM nodes"
       },
       "properties": [
        {
         "id": "custom.axisPlacement",
         "value": "right"
        },
        {
         "id": "unit",
         "value": "short"
        }
       ]
      },
      {
       "matcher": {
        "id": "byName",
        "options": "heap"
       },
       "properties": [
        {
         "id": "unit",
         "value": "decmbytes"
        }
       ]
      }
     ]
    },
    "options": {},
    "transformations": []
   },
   {
    "id": 6,
    "type": "timeseries",
    "title": "Renderer threads, % of one core (adb)",
    "description": "CrRendererMain at 100% is the page main thread stuck. Needs scripts/frame-monitor running.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 12,
     "y": 22,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, thread, max(cpu_pct) AS cpu FROM frame_thread WHERE proc = 'renderer' AND $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {},
      "unit": "percent"
     },
     "overrides": []
    },
    "options": {},
    "transformations": [
     {
      "id": "partitionByValues",
      "options": {
       "fields": [
        "thread"
       ],
       "keepFields": false
      }
     }
    ]
   },
   {
    "id": 7,
    "type": "timeseries",
    "title": "Processes, % of one core (adb)",
    "description": "ime is the on-screen keyboard app.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 30,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, proc, max(cpu_pct) AS cpu FROM frame_proc WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {},
      "unit": "percent"
     },
     "overrides": []
    },
    "options": {},
    "transformations": [
     {
      "id": "partitionByValues",
      "options": {
       "fields": [
        "proc"
       ],
       "keepFields": false
      }
     }
    ]
   },
   {
    "id": 8,
    "type": "timeseries",
    "title": "Memory (adb)",
    "description": "",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 12,
     "y": 30,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, min(mem_avail_mb) AS \"available\", max(swap_used_mb) AS \"swap used\" FROM frame_sys WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {},
      "unit": "decmbytes"
     },
     "overrides": []
    },
    "options": {},
    "transformations": []
   },
   {
    "id": 9,
    "type": "timeseries",
    "title": "CPU, clock and temperature (adb)",
    "description": "",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 0,
     "y": 38,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "time_series",
      "rawSql": "SELECT $__dateBin(time) AS time, max(cpu_pct) AS \"CPU busy %\", max(freq_mhz) AS \"clock MHz\", max(temp_c) AS \"temp C\", max(adb) AS \"adb up\" FROM frame_sys WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {}
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "clock MHz"
       },
       "properties": [
        {
         "id": "custom.axisPlacement",
         "value": "right"
        }
       ]
      }
     ]
    },
    "options": {},
    "transformations": []
   },
   {
    "id": 10,
    "type": "table",
    "title": "Freezes caught by the DevTools recorder",
    "description": "Trace and stacks files are in diagnostics/akimart-rk3326/freezes/ on the server.",
    "datasource": {
     "type": "influxdb",
     "uid": "frame-influx"
    },
    "gridPos": {
     "x": 12,
     "y": 38,
     "w": 12,
     "h": 8
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "table",
      "rawSql": "SELECT time, ms, samples, stack, trace FROM freeze WHERE source = 'cdp' AND $__timeFilter(time) ORDER BY time DESC"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "custom": {
       "cellOptions": {
        "type": "auto",
        "wrapText": true
       },
       "inspect": true
      }
     },
     "overrides": [
      {
       "matcher": {
        "id": "byName",
        "options": "ms"
       },
       "properties": [
        {
         "id": "unit",
         "value": "ms"
        }
       ]
      }
     ]
    },
    "options": {},
    "transformations": []
   }
  ],
  "annotations": {
   "list": [
    {
     "name": "Freezes",
     "enable": true,
     "iconColor": "red",
     "datasource": {
      "type": "influxdb",
      "uid": "frame-influx"
     },
     "target": {
      "refId": "A",
      "datasource": {
       "type": "influxdb",
       "uid": "frame-influx"
      },
      "rawQuery": true,
      "editorMode": "code",
      "format": "table",
      "rawSql": "SELECT time, concat(source, ' freeze ', CAST(ms AS BIGINT), ' ms on ', \"view\") AS text FROM freeze WHERE $__timeFilter(time) ORDER BY time"
     }
    }
   ]
  }
 },
 "overwrite": true
}